---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SubstackFeed from '../components/SubstackFeed.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-pt-20 scroll-smooth">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main { width: 100%; max-width: 100%; margin: 0; padding: 0; }
      .hero-img { height: 100% !important; object-position: center 60%; }
    </style>
  </head>
  <body class="bg-background text-foreground">
    <Header />

    <main>
      <!-- Hero -->
      <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
        <img
          src="/images/hero.jpg"
          alt="Lauren Beckman at Machu Picchu"
          class="hero-img absolute inset-0 w-full h-full object-cover"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-linear-to-b from-black/25 via-black/45 to-black/65"></div>

        <div class="relative z-10 max-w-4xl mx-auto px-6 py-28 text-center text-white">
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter mb-3 text-white! drop-shadow-2xl">
            Lauren Beckman
          </h1>
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl mb-6 text-white/90">
            Writing • Recipes • Photography
          </p>
          <p class="text-base md:text-xl max-w-xl mx-auto mb-10 text-white/85">
            A law student and engineer beneath the sun, and a writer, photographer, and cook once the light fades.
          </p>

          <div class="flex flex-col sm:flex-row flex-wrap justify-center items-center gap-4">
            <a href="#essays"
               class="group bg-primary hover:bg-primary/90 text-primary-foreground px-8 py-3.5 rounded-full font-medium text-lg transition-all duration-300 hover:scale-105 active:scale-95 flex items-center gap-2 shadow-lg">
              Read essays
            </a>
            <a href="#recipes"
               class="group border-2 border-white/80 hover:bg-white/10 text-white px-8 py-3.5 rounded-full font-medium text-lg transition-all duration-300 hover:scale-105 active:scale-95">
              Browse recipes
            </a>
            <a href="#photography"
               class="group border-2 border-white/80 hover:bg-white/10 text-white px-8 py-3.5 rounded-full font-medium text-lg transition-all duration-300 hover:scale-105 active:scale-95">
              View photography
            </a>
          </div>
        </div>
      </section>

      <!-- Substack Feeds -->
      <div class="max-w-6xl mx-auto px-6 py-16">
        <SubstackFeed />
      </div>

      <!-- Instagram Photography -->
      <InstagramGrid />
    </main>

    <Footer />
  </body>
</html>
