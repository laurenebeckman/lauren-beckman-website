---
import Parser from 'rss-parser';
const parser = new Parser();

const essays = await parser.parseURL('https://essayswritten.substack.com/feed');
const recipes = await parser.parseURL('https://recipeswritten.substack.com/feed');

function coverSrc(url?: string) {
	if (!url) return '';
	const params = 'w_1200,c_limit,f_auto,q_auto:good';
	if (url.includes('substackcdn.com/image/fetch/')) {
		return url.replace('/image/fetch/', `/image/fetch/${params}/`);
	}
	return `https://substackcdn.com/image/fetch/${params}/${encodeURIComponent(url)}`;
}

function posted(pubDate?: string) {
	if (!pubDate) return '';
	return new Date(pubDate).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}
---

<div class="space-y-16">
  <section id="essays">
    <h2 class="text-4xl font-bold mb-3 text-zinc-900">Latest Essays</h2>
    <p class="text-base text-zinc-700 mb-8 max-w-2xl">
      <a
        href="https://essayswritten.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="italic text-pink hover:text-pink-dark"
      >Essays Written</a>
      — personal essays. These are the newest ones.
    </p>
    <div class="grid md:grid-cols-2 gap-8">
      {essays.items.slice(0, 4).map((post: any) => (
        <article class="group bg-white border border-stone-200 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">
          {post.enclosure?.url && (
            <img
              src={coverSrc(post.enclosure.url)}
              alt={post.title}
              loading="lazy"
              class="w-full h-72 object-cover group-hover:scale-105 transition-transform duration-500"
            />
          )}
          <div class="p-8 grow">
            <h3 class="text-lg font-semibold mb-3 leading-tight text-zinc-900 group-hover:text-primary transition-colors">
              <a href={post.link} target="_blank" rel="noopener noreferrer">{post.title}</a>
            </h3>

            <p class="text-sm text-stone-400 mb-4">
              {posted(post.pubDate)}
            </p>

            <p class="line-clamp-3 text-zinc-700 mb-6">
              {post.contentSnippet || post.description}
            </p>

            <a
              href={post.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-pink font-medium hover:text-pink-dark transition-colors"
            >
              Read on Substack →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="recipes">
    <h2 class="text-4xl font-bold mb-3 text-zinc-900">Latest Recipes</h2>
    <p class="text-base text-zinc-700 mb-8 max-w-2xl">
      <a
        href="https://recipeswritten.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="italic text-pink hover:text-pink-dark"
      >Recipes Written</a>
      — from the kitchen. These are the newest ones.
    </p>
    <div class="grid md:grid-cols-2 gap-8">
      {recipes.items.slice(0, 4).map((post: any) => (
        <article class="group bg-white border border-stone-200 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">
          {post.enclosure?.url && (
            <img
              src={coverSrc(post.enclosure.url)}
              alt={post.title}
              loading="lazy"
              class="w-full h-72 object-cover group-hover:scale-105 transition-transform duration-500"
            />
          )}
          <div class="p-8 grow">
            <h3 class="text-lg font-semibold mb-3 leading-tight text-zinc-900 group-hover:text-primary transition-colors">
              <a href={post.link} target="_blank" rel="noopener noreferrer">{post.title}</a>
            </h3>

            <p class="text-sm text-stone-400 mb-4">
              {posted(post.pubDate)}
            </p>

            <p class="line-clamp-3 text-zinc-700 mb-6">
              {post.contentSnippet || post.description}
            </p>

            <a
              href={post.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-pink font-medium hover:text-pink-dark transition-colors"
            >
              Read on Substack →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>
