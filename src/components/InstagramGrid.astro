<section id="photography" class="max-w-6xl mx-auto px-6 py-16">
  <h2 class="text-4xl font-bold tracking-tight text-center mb-3">Photography</h2>
  <p class="text-center text-base text-zinc-700 mb-12">an ongoing series, pictures taken.</p>

  <div class="columns-1 sm:columns-2 lg:columns-3 gap-8">
    {instagramPosts.map((post) => (
      <figure class="break-inside-avoid mb-8">
        <a
          href={post.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block"
        >
          <div class="overflow-hidden rounded-md shadow-md group-hover:shadow-xl transition-shadow duration-300">
            <img
              src={post.img}
              alt={post.caption}
              loading="lazy"
              class="w-full h-auto group-hover:scale-[1.02] transition-transform duration-500"
            />
          </div>
        </a>
        <figcaption class="mt-2 text-sm leading-snug text-stone-500">
          {post.caption}
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="text-center mt-4">
    <a
      href="https://www.instagram.com/laurenebeckman_/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 text-lg font-medium hover:text-pink-500 transition-colors"
    >
      See more on Instagram →
    </a>
  </div>
</section>
